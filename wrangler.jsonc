{
  // Deployment config for the built vinext output.
  //
  // `vinext build` emits a Cloudflare Worker (dist/server/index.js) plus the
  // static client bundle (dist/client). That is a Worker with static assets,
  // not a plain static directory, so this is the target rather than a static
  // host. `no_bundle` is set because the output is already bundled; the
  // ESModule rule lets the entry import its sibling ./ssr/index.js chunk.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steadyinfaith",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  // nodejs_compat is deliberately NOT listed here. The entry imports
  // node:async_hooks, so Wrangler adds the flag itself; declaring it as well
  // makes the upload fail with "Compatibility flag specified multiple times".
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "observability": { "enabled": true }
}
